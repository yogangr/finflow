# Connection string dari dashboard Neon (Connection Details)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
# Password untuk masuk ke dasbor
APP_PASSWORD=ganti-dengan-password-kuat
# String acak panjang untuk menandatangani sesi (buat: openssl rand -hex 32)
AUTH_SECRET=ganti-dengan-string-acak-panjang
